{
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [ "**/*.csproj" ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/test/**",
            "**/*.Test/**",
            "**/*.Tests/**"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/*.yml", "api/index.md" ]
      },
      {
        "files": [ "**.md", "**/*.yml" ],
        "exclude": [
          "_site/**",
          "obj/**",
          "api/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "YongAnGame.ModuleLib",
      "_appTitle": "YongAnGame.ModuleLib 文档",
      "_appFooter": "© 2026 YongAnGame. All rights reserved.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/YongAnGame/YongAnGame.ModuleLib",
        "branch": "main"
      },
      "_lang": "zh-CN"
    },
    "template": [ "default", "modern" ],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false
  }
}