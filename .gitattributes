* text=auto eol=lf

# 明确不碰的二进制文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.dll  binary
*.exe  binary
*.pdb  binary
*.so   binary
*.dylib binary
*.nupkg binary
*.snk  binary

