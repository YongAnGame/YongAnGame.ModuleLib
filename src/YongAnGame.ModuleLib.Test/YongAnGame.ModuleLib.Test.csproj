<Project Sdk="MSTest.Sdk/4.5.2">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
	<NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
    
    <PropertyGroup>
        <!-- 默认全平台 -->
        <TargetFrameworks>net47;net48;net8.0;net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <!-- 非 Windows 只保留可跑的 TFM -->
    <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">
        <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Polyfill" Version="12.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\YongAnGame.ModuleLib\YongAnGame.ModuleLib.csproj" />
  </ItemGroup>
</Project>
