<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net48;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AnalysisLevel>latest-Recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		
		<!-- NuGet 包元数据（注意：没有 <Version>，由 MinVer 推导） -->
		<PackageId>YongAnGame.ModuleLib</PackageId>
		<Authors>YongAnGame</Authors>
		<Description>面向游戏 MOD 系统的通用模块库，提供配置加载、序列化、仓储管理等基础设施</Description>
		<PackageTags>game;mod;config;serialization;yaml;json</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/YongAnGame/YongAnGame.ModuleLib</PackageProjectUrl>
		<RepositoryUrl>https://github.com/YongAnGame/YongAnGame.ModuleLib</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<!-- ────────────────────────────────────────────── -->
	<!-- 全目标框架通用依赖                               -->
	<!-- ────────────────────────────────────────────── -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<!-- ────────────────────────────────────────────── -->
	<!-- netstandard2.0 + net48：缺失大量 BCL API        -->
	<!-- ────────────────────────────────────────────── -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net48'">
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.15" />
		<PackageReference Include="Polyfill" Version="12.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- ────────────────────────────────────────────── -->
	<!-- netstandard2.1：有 Range/Index/HashCode，       -->
	<!-- 但缺 IParsable、ThrowIfXxx、CallerArgumentExpr  -->
	<!-- ────────────────────────────────────────────── -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Text.Json" Version="10.0.15" />
		<PackageReference Include="Polyfill" Version="12.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>