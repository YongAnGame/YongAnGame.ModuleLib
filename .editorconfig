root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# ============================================================
# var 规则：仅 new / as / 转换 时用 var，其余显式声明
# ============================================================
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# ============================================================
# 命名空间与 using
# ============================================================
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning

# ============================================================
# 大括号与换行
# ============================================================
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all

# ============================================================
# 类型与限定
# ============================================================
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion

# ============================================================
# 修饰符顺序与空行
# ============================================================
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion
dotnet_style_allow_multiple_blank_lines_experimental = false
dotnet_diagnostic.IDE2000.severity = warning

# ============================================================
# 命名规范（IDE1006）——符号匹配 → 样式定义 → 规则关联，三段缺一不可
# ============================================================

# ---------- 1. 符号匹配 ----------
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.class.applicable_kinds = class
dotnet_naming_symbols.struct.applicable_kinds = struct
dotnet_naming_symbols.record.applicable_kinds = record
dotnet_naming_symbols.enum.applicable_kinds = enum
dotnet_naming_symbols.delegate.applicable_kinds = delegate
dotnet_naming_symbols.method.applicable_kinds = method
dotnet_naming_symbols.property.applicable_kinds = property
dotnet_naming_symbols.event.applicable_kinds = event

dotnet_naming_symbols.constant.applicable_kinds = field
dotnet_naming_symbols.constant.required_modifiers = const

dotnet_naming_symbols.private_field.applicable_kinds = field
dotnet_naming_symbols.private_field.applicable_accessibilities = private, internal

dotnet_naming_symbols.static_field.applicable_kinds = field
dotnet_naming_symbols.static_field.required_modifiers = static

dotnet_naming_symbols.parameter.applicable_kinds = parameter
dotnet_naming_symbols.local_variable.applicable_kinds = local
dotnet_naming_symbols.type_parameter.applicable_kinds = type_parameter

# ---------- 2. 样式定义 ----------
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.s_camel.capitalization = camel_case
dotnet_naming_style.s_camel.required_prefix = s_

dotnet_naming_style.t_prefix.capitalization = pascal_case
dotnet_naming_style.t_prefix.required_prefix = T

# ---------- 3. 规则关联 ----------
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = interface_prefix

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = class, struct, record, enum, delegate
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.methods_should_be_pascal_case.severity = warning
dotnet_naming_rule.methods_should_be_pascal_case.symbols = method
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.properties_should_be_pascal_case.severity = warning
dotnet_naming_rule.properties_should_be_pascal_case.symbols = property
dotnet_naming_rule.properties_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constant
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.private_fields_should_be_underscore_camel.severity = warning
dotnet_naming_rule.private_fields_should_be_underscore_camel.symbols = private_field
dotnet_naming_rule.private_fields_should_be_underscore_camel.style = underscore_camel

dotnet_naming_rule.static_fields_should_be_s_camel.severity = warning
dotnet_naming_rule.static_fields_should_be_s_camel.symbols = static_field
dotnet_naming_rule.static_fields_should_be_s_camel.style = s_camel

dotnet_naming_rule.parameters_should_be_camel_case.severity = warning
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameter
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case

dotnet_naming_rule.locals_should_be_camel_case.severity = warning
dotnet_naming_rule.locals_should_be_camel_case.symbols = local_variable
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case

dotnet_naming_rule.type_parameters_should_start_with_t.severity = warning
dotnet_naming_rule.type_parameters_should_start_with_t.symbols = type_parameter
dotnet_naming_rule.type_parameters_should_start_with_t.style = t_prefix

# 命名违规统一严重级别
dotnet_diagnostic.IDE1006.severity = warning
